# Copy with scripts/init-env.ps1; it generates a local database password.
DATABASE_PASSWORD=replace-with-random-password
APP_DEMO=true
ADMIN_PASSWORD=DemoAdmin!2026
CUSTOMER_PASSWORD=DemoCustomer!2026
AGENT_PASSWORD=DemoAgent!2026
APP_ORIGIN=http://127.0.0.1:19082,http://localhost:19082
WEB_PORT=19082
BIND_HOST=127.0.0.1
OLLAMA_URL=http://host.docker.internal:28434
CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
EMBED_MODEL=qwen3-embedding:0.6b
AI_ENABLED=true
MODEL_KEEP_ALIVE=5m
COOKIE_SECURE=false
DEPLOYMENT_MODE=local
# Optional middleware is enabled with scripts/start.ps1 -Middleware.
# Separate Redis/RabbitMQ passwords may be set; otherwise the local DB secret is reused.
CACHE_NAMESPACE=desk
# REDIS_PASSWORD=replace-with-another-random-password
# RABBITMQ_USER=desk
# RABBITMQ_PASSWORD=replace-with-another-random-password
# MYSQL_WEB_PORT=19083
# MYSQL_APP_ORIGIN=http://127.0.0.1:19083,http://localhost:19083
# APP_PROFILES=mysql,observability
